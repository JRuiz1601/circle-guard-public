pipeline {
    agent any
    environment {
        SERVICE_NAME = 'circleguard-gateway-service'
        IMAGE = "ghcr.io/jruiz1601/${SERVICE_NAME}:${BUILD_NUMBER}"
        GITHUB_USER = credentials('GITHUB_USER')
        GHCR_TOKEN = credentials('GHCR_TOKEN')
        NAMESPACE = 'circleguard-prod'
        KUBECONFIG = '/var/jenkins_home/.kube/config'
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Build') {
            steps {
                sh "./gradlew :services:${SERVICE_NAME}:build -x test --no-daemon"
            }
        }
        stage('Unit Tests') {
            steps {
                sh "./gradlew :services:${SERVICE_NAME}:test --no-daemon -Dorg.gradle.jvmargs='-Xmx256m' -Dorg.gradle.daemon=false"
            }
        }
        stage('Integration Tests') {
            steps {
                echo 'Sin pruebas *PostgresIntegrationIT en gateway — stage omitido.'
            }
        }
        stage('System Tests') {
            steps {
                sh """
                    if [ "\${SKIP_SYSTEM_TESTS:-true}" = "false" ]; then
                        ./gradlew :tests:e2e:test --no-daemon -Dorg.gradle.jvmargs='-Xmx512m' -Dorg.gradle.daemon=false
                    else
                        echo "System Tests: :tests:e2e omitido (SKIP_SYSTEM_TESTS=true). Pon false con port-forward / cluster accesible desde el agente."
                    fi
                """
            }
        }
        stage('Docker Build') {
            steps {
                sh "docker build -t ${IMAGE} -f services/${SERVICE_NAME}/Dockerfile ."
            }
        }
        stage('Push to GHCR') {
            steps {
                sh """
                    echo \${GHCR_TOKEN} | docker login ghcr.io -u \${GITHUB_USER} --password-stdin
                    docker push ${IMAGE}
                """
            }
        }
        stage('Deploy to Prod') {
            steps {
                sh "sed -i 's/:latest/:\${BUILD_NUMBER}/g' k8s/prod/${SERVICE_NAME}/deployment.yaml"
                sh "kubectl apply -f k8s/prod/${SERVICE_NAME}/ --namespace=\${NAMESPACE} --validate=false"
            }
        }
        stage('Release Notes') {
            steps {
                sh """
                    chmod +x scripts/generate-release-notes.sh
                    bash scripts/generate-release-notes.sh
                """
            }
        }
    }
    post {
        always {
            junit allowEmptyResults: true, testResults: "services/${SERVICE_NAME}/build/test-results/test/*.xml,tests/e2e/build/test-results/test/*.xml"
            cleanWs()
        }
        success {
            echo "✅ circleguard-gateway-service deployed to PROD"
        }
        failure {
            echo "❌ Pipeline MASTER/PROD failed for circleguard-gateway-service"
        }
    }
}
