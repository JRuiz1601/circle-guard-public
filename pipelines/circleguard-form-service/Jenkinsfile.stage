pipeline {
    agent any
    environment {
        SERVICE_NAME = 'circleguard-form-service'
        IMAGE = "ghcr.io/jruiz1601/${SERVICE_NAME}:${BUILD_NUMBER}"
        GITHUB_USER = credentials('GITHUB_USER')
        GHCR_TOKEN = credentials('GHCR_TOKEN')
        NAMESPACE = 'circleguard-stage'
        KUBECONFIG = '/var/jenkins_home/.kube/config'
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Build') {
            steps {
                sh "./gradlew :services:${SERVICE_NAME}:build -x test --no-daemon"
            }
        }
        stage('Unit Tests') {
            steps {
                sh """
                    ./gradlew :services:${SERVICE_NAME}:test --no-daemon \\
                        -Dorg.gradle.jvmargs='-Xmx256m' -Dorg.gradle.daemon=false \\
                        --tests 'com.circleguard.form.integration.FormIntegrationMvcTest' \\
                        --tests 'com.circleguard.form.service.HealthSurveyServiceTest' \\
                        --tests 'com.circleguard.form.controller.FormIntegrationTests' \\
                        --tests 'com.circleguard.form.controller.AttachmentControllerTest' \\
                        --tests 'com.circleguard.form.service.SymptomMapperTest' \\
                        --tests 'com.circleguard.form.controller.QuestionnaireControllerTest' \\
                        --tests 'com.circleguard.form.controller.HealthSurveyControllerTest'
                """
            }
        }
        stage('Integration Tests') {
            environment {
                TESTCONTAINERS_RYUK_DISABLED = 'true'
            }
            steps {
                sh "./gradlew :services:${SERVICE_NAME}:test --tests '*PostgresIntegrationIT' --no-daemon -Dorg.gradle.jvmargs='-Xmx512m' -Dorg.gradle.daemon=false"
            }
        }
        stage('Docker Build') {
            steps {
                sh "docker build -t ${IMAGE} -f services/${SERVICE_NAME}/Dockerfile ."
            }
        }
        stage('Push to GHCR') {
            steps {
                sh """
                    echo \${GHCR_TOKEN} | docker login ghcr.io -u \${GITHUB_USER} --password-stdin
                    docker push ${IMAGE}
                """
            }
        }
        stage('Deploy to Stage') {
            steps {
                sh "sed -i 's/:latest/:\${BUILD_NUMBER}/g' k8s/stage/${SERVICE_NAME}/deployment.yaml"
                sh "kubectl apply -f k8s/stage/${SERVICE_NAME}/ --namespace=\${NAMESPACE} --validate=false"
            }
        }
    }
    post {
        always {
            junit allowEmptyResults: true, testResults: "services/${SERVICE_NAME}/build/test-results/test/*.xml"
            cleanWs()
        }
        success {
            echo "✅ circleguard-form-service deployed to STAGE"
        }
        failure {
            echo "❌ Pipeline STAGE failed for circleguard-form-service"
        }
    }
}
