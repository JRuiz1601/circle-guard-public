pipeline {
    agent any
    environment {
        SERVICE_NAME = 'circleguard-file-service'
        IMAGE = "ghcr.io/jruiz1601/${SERVICE_NAME}:${BUILD_NUMBER}"
        GITHUB_USER = credentials('GITHUB_USER')
        GHCR_TOKEN = credentials('GHCR_TOKEN')
        NAMESPACE = 'circleguard-dev'
        KUBECONFIG = '/var/jenkins_home/.kube/config'
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Build') {
            steps {
                sh "./gradlew :services:${SERVICE_NAME}:build -x test --no-daemon"
            }
        }
        stage('Unit Tests') {
            steps {
                sh "./gradlew :services:${SERVICE_NAME}:test --no-daemon -Dorg.gradle.jvmargs='-Xmx256m' -Dorg.gradle.daemon=false"
            }
        }
        stage('Docker Build') {
            steps {
                sh "docker build -t ${IMAGE} -f services/${SERVICE_NAME}/Dockerfile ."
            }
        }
        stage('Push to GHCR') {
            steps {
                sh """
                    echo \${GHCR_TOKEN} | docker login ghcr.io -u \${GITHUB_USER} --password-stdin
                    docker push ${IMAGE}
                """
            }
        }
        stage('Deploy to Dev') {
            steps {
                sh "sed -i 's/:latest/:\${BUILD_NUMBER}/g' k8s/dev/circleguard-file-service/deployment.yaml"
                sh "kubectl apply -f k8s/dev/circleguard-file-service/ --namespace=\${NAMESPACE} --validate=false"
            }
        }
    }
    post {
        always {
            junit allowEmptyResults: true, testResults: "services/circleguard-file-service/build/test-results/test/*.xml"
            cleanWs()
        }
        success {
            echo "✅ circleguard-file-service deployed to DEV"
        }
        failure {
            echo "❌ Pipeline failed for circleguard-file-service"
        }
    }
}
